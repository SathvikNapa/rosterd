# Copy to .env.local and edit. Defaults match docker-compose.yml plus
# rosterd-ingestion/scripts/run.sh.

VITE_INGESTION_URL=http://localhost:8000
VITE_KERNEL_URL=http://localhost:8100
VITE_COORDINATOR_URL=http://localhost:8300
VITE_SPACETIMEDB_URL=http://localhost:3000
VITE_SPACETIMEDB_MODULE=rosterd
VITE_JAEGER_BASE_URL=http://localhost:16686

# The site this UI drives. compose brings up kernel-site-a.
VITE_SITE_ID=site-a

# live = talk to the services. demo = render the Figma fixtures, no backend.
VITE_ROSTERD_MODE=live

# HTTP-SQL poll interval, used until generated bindings exist.
VITE_POLL_INTERVAL_MS=2000
